# vibe.code-agent configuration (ADR-10). Copy to .env and edit:
#   cp .env.example .env

# Hugging Face read token (required for gated repos, e.g. Llama 3.1)
HF_TOKEN=

# Shared data dir: HF cache for vLLM containers and laboratory/ (ADR-8)
VIBE_DATA_DIR=~/.cache/huggingface

# Bind address for controller (:50051), gateway (:8080), admin (:8081) (XR-1)
VIBE_BIND=127.0.0.1

# Gateway: load a non-active model on request instead of returning 503
VIBE_SWAP_ON_REQUEST=false

# Gateway: how long to wait for a swap-on-request (seconds)
VIBE_SWAP_TIMEOUT=180

# Load readiness timeout (seconds)
VIBE_LOAD_TIMEOUT=600

# Pinned vLLM image tag — never "latest" (XR-6).
# TODO(verify): confirm this tag serves AWQ checkpoints on Ada (sm_89) before first use.
VLLM_IMAGE_TAG=v0.11.2
