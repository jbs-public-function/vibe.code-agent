# vibe OpenAI-compatible gateway (HTTP) — systemd USER unit.
#
# Talks to the controller over gRPC at 127.0.0.1:50051, so the controller
# unit (vibe-controller.service) must be running first.
#
# Install and start with:
#   systemctl --user daemon-reload
#   systemctl --user enable --now vibe-gateway
#
# Follow logs with:   journalctl --user -u vibe-gateway -f
# Check status with:  systemctl --user status vibe-gateway

[Unit]
Description=vibe gateway (OpenAI API)
After=vibe-controller.service

[Service]
Type=simple
WorkingDirectory=/home/jamesb/projects/vibe.code-agent
ExecStart=/home/jamesb/projects/vibe.code-agent/.venv/bin/vibe serve --only gateway
Restart=on-failure

[Install]
WantedBy=default.target
